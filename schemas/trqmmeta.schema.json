{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trqm.local/schemas/trqmmeta.schema.json",
  "title": "TRQMMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "author",
    "country",
    "company",
    "keywords",
    "updated_at",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "doc_id": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string" },
    "title": { "type": "string" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "country": {
      "type": "array",
      "items": { "type": "string", "minLength": 2, "maxLength": 3 }
    },
    "company": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "owner": { "type": "string" },
    "review_due_at": { "type": "string", "format": "date-time" },
    "confidentiality": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "summary": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    }
  }
}
